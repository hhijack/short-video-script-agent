# 真实模型接入（OpenAI 兼容 Chat Completions 接口）。
# 三项全部配置后可用 --model real 运行；不配置时请使用 --model mock（离线入口，无需任何变量）。
# 注意：.env 已被 .gitignore 忽略，禁止把真实密钥提交进仓库。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 可选：每轮工具调用次数上限（默认 12；也可用 CLI --max-steps 覆盖）
MAX_TOOL_CALLS=12

# 可选：真实模型单次请求读超时秒数（默认 180；生成较长动作 JSON 时 60s 可能不够）
LLM_TIMEOUT=180
